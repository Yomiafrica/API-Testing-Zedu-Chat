    {
      "name": "Login",
      "item": [
        {
          "name": "Login with valid details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tests\r",
                  "pm.test(\"Status code is 200\", () => {\r",
                  "  pm.expect(pm.response.code).to.equal(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains access_token\", () => {\r",
                  "  const body = pm.response.json();\r",
                  "  pm.expect(body.data).to.have.property(\"access_token\");\r",
                  "\r",
                  "  if (body.data?.access_token) {\r",
                  "    pm.collectionVariables.set(\"token\", body.data.access_token);\r",
                  "  }\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status is success\", () => {\r",
                  "  const body = pm.response.json();\r",
                  "  pm.expect(body.status).to.equal(\"success\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Success message\", () => {\r",
                  "  const body = pm.response.json();\r",
                  "  pm.expect(body.message.toLowerCase()).to.include(\"login\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains user id\", () => {\r",
                  "  const body = pm.response.json();\r",
                  "  pm.expect(body.data.user).to.have.property(\"id\");\r",
                  "\r",
                  "  if (body.data?.user?.id) {\r",
                  "    pm.collectionVariables.set(\"userId\", body.data.user.id);\r",
                  "  }\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains user id\", () => {\r",
                  "  const body = pm.response.json();\r",
                  "  pm.expect(body.data.user.organisation).to.have.property(\"id\");\r",
                  "\r",
                  "  if (body.data?.user?.organisation?.id) {\r",
                  "    pm.collectionVariables.set(\"org_id\", body.data.user.organisation.id);\r",
                  "  }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
