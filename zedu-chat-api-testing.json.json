      "name": "Registration",
      "item": [
        {
          "name": "Register a new user with valid details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 - Account Created', () => {\r",
                  "  pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test('Response returns user created successfully message', () => {\r",
                  "  pm.expect(json).to.have.property('message');\r",
                  "  pm.expect(json.message).to.be.a('string').and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test('Password is not exposed in response', () => {\r",
                  "  pm.expect(json).to.not.have.property('password');\r",
                  "});\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
